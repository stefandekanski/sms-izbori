{
  "name": "SMS Izbori",
  "short_name": "SMS Izbori",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#1E4C8F",
  "background_color": "#ffffff",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://stefandekanski.github.io/sms-izbori/manifest.webmanifest"
    }
  ]
}
